# Postgres on the LAN server (fill in the password)
DATABASE_URL=postgres://on_track:CHANGE_ME@192.168.1.65:5432/on_track

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (Phase 2b). Real values go in .env.local only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email over SMTP (Phase 2c). With Resend: host smtp.resend.com, port 465,
# user "resend", password = an API key with sending access
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Tests (bun test) read TEST_DATABASE_URL from .env.test.local, not from this file.
# It must be a database whose name ends in _test; the tests delete all of its data.
TEST_DATABASE_URL=postgres://on_track_test:CHANGE_ME@localhost:5432/on_track_test

